# Log level (info, debug, trace)
RUST_LOG=info

# Public VPN UDP port and internal bind address.
VPN_PORT=10443
VPN_BIND_ADDR=0.0.0.0:10443

# Optional HTTP/2 CONNECT-IP listener over TLS/TCP.
# It may use the same numeric port as the UDP listener because the protocols differ.
# HTTP/2 is mutually exclusive with CR mode, HTTP/3 framing, and ECH.
# VPN_HTTP2_BIND_ADDR=0.0.0.0:10443

# Static token used only when Keycloak is disabled.
# The installer generates this for classic mode. Never deploy an example/default value.
VPN_AUTH_TOKEN=

# Fixed inner TUN MTU. The outer QUIC payload MTU is derived as VPN_MTU + 80.
VPN_MTU=1280

# Client networks. Keep the IPv6 network in the ULA range, not a provider prefix.
VPN_NETWORK=10.8.0.0/24
VPN_NETWORK_V6=fd00::/64

# IPv6 routing requires net.ipv6.conf.all.forwarding=1 on the host.
# On RA-based clouds, the WAN interface also needs accept_ra=2.
# Set VPN_DISABLE_IPV6=true for an intentionally IPv4-only server.
# VPN_DISABLE_IPV6=false
# VPN_IPV6_WAIT=30

# DNS server sent to clients.
VPN_DNS=1.1.1.1

# HTTP/3 camouflage and Encrypted Client Hello settings.
VPN_CENSORSHIP_RESISTANT=true
# VPN_ECH_PUBLIC_NAME=cloudflare-ech.com

# TCP MSS clamping inside the tunnel.
VPN_MSS_CLAMPING=false
# VPN_TUN_DEVICE=mavi0

# Reverse proxy for the auth.<domain> and panel.<domain> subdomains.
# Recommended (also the installer default): host Nginx with Let's Encrypt.
# The installer installs and configures Nginx/Certbot; no Compose profile is
# needed. Keycloak and the panel publish loopback HTTP ports (127.0.0.1:18080
# and 127.0.0.1:18081) that Nginx forwards to.
# DOMAIN_NAME=example.com
# ACME_EMAIL=admin@example.com

# Legacy standalone Traefik profile: public 80/443, HTTPS routers, and ACME.
# Existing installations keep this mode; the installer no longer selects it.
# COMPOSE_PROFILES=traefik
# TRAEFIK_BIND_ADDR=0.0.0.0
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
# TRAEFIK_ROUTER_ENTRYPOINTS=websecure
# TRAEFIK_TLS_ENABLED=true
# TRAEFIK_ACME_RESOLVER=myresolver
# TRAEFIK_FORWARDED_HEADERS_INSECURE=false

# External reverse proxy (advanced): you terminate HTTPS and forward to the
# published loopback ports; leave COMPOSE_PROFILES empty and omit the Traefik
# variables. Existing external setups that used loopback Traefik keep working
# unchanged.

# Keycloak authentication (OIDC).
# Keycloak-only uses docker-compose.yml:keycloak/docker-compose.yml.
# COMPOSE_FILE=docker-compose.yml:keycloak/docker-compose.yml
VPN_KEYCLOAK_ENABLED=false
# VPN_KEYCLOAK_URL=https://auth.example.com
# VPN_KEYCLOAK_REALM=mavi-vpn
# VPN_KEYCLOAK_CLIENT_ID=mavi-client

# Optional fail-closed authorization policy for accepted VPN JWTs.
# The panel compose override defaults the required role to vpn-user.
# VPN_KEYCLOAK_REQUIRED_ROLE=vpn-user
# VPN_KEYCLOAK_REQUIRED_SCOPE=vpn:connect

# Keycloak Postgres and initial master-admin credentials.
# KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASS=

# Web panel selection. The installer derives COMPOSE_FILE from this mode.
# Enabling the panel always enables Keycloak, even if the old Keycloak value was false.
# Panel mode uses docker-compose.yml:keycloak/docker-compose.yml:panel/docker-compose.yml
# and needs no VPN_AUTH_TOKEN.
MAVI_WEB_PANEL_ENABLED=false

# Panel secrets and explicit values generated by the installer.
# MAVI_PANEL_DB_PASSWORD=
# MAVI_PANEL_CLIENT_SECRET=
# Shared credential that authenticates forwarded client IPs from the reverse proxy.
# MAVI_PANEL_PROXY_TOKEN=
# The endpoint is explicit to avoid nested Compose variable interpolation.
# MAVI_PANEL_VPN_ENDPOINT=vpn.example.com:10443
# Values: http3_censorship_resistant, quic, or http2 when HTTP/2 is configured.
# MAVI_PANEL_TRANSPORT=http3_censorship_resistant
