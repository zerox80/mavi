# One configuration template for IPv4-only and IPv4 + IPv6 installations.
# New installation:
#   cp .env.example .env
#   chmod 600 .env
#   openssl rand -hex 32
#   nano .env
# Paste the generated token into VPN_AUTH_TOKEN below.
# Existing installation: edit your .env and keep your current authentication settings.
#
# IPv6 quick setup: change these existing settings below (one entry per key):
#   VPN_DISABLE_IPV6=false
#   VPN_BIND_ADDR=[::]:10443
# The IPv6 subnet, DNS and startup wait are already filled in below.
# Keep VPN_BIND_ADDR=0.0.0.0:10443 if clients only connect to the server over IPv4;
# they can still use IPv6 inside the tunnel when VPN_DISABLE_IPV6=false.
# No public server IP needs to be entered for either wildcard listener.
# First complete the host setup in README.md -> Enabling IPv6:
# public IPv6 on the IPv4 WAN interface, IPv6 forwarding, and IPv6 firewall rules.
# The .env file configures the VPN; it cannot enable host forwarding itself.

# Image from GitHub Container Registry. Pin @sha256:... for controlled updates.
MAVI_IMAGE=ghcr.io/zerox80/mavi-vpn:latest

# Container RAM cap, not a measured minimum requirement. Increase for high load.
# Container swap is disabled by setting memswap_limit to the same value.
MAVI_MEMORY_LIMIT=512m

# Required unless using Keycloak. Generate with: openssl rand -hex 32
# Paste the generated value after =. An empty token stops startup before
# certificates are created in ./data (unless Keycloak is enabled).
VPN_AUTH_TOKEN=
RUST_LOG=info

# QUIC/UDP listener. Open this UDP port in the host AND provider firewall.
# 0.0.0.0:10443 = connections over IPv4.
# [::]:10443 = connections over IPv6 and also IPv4 when net.ipv6.bindv6only=0.
# IPv6 traffic INSIDE the VPN also works with the IPv4 listener.
VPN_BIND_ADDR=0.0.0.0:10443

# Optional HTTP/2 over TLS/TCP. Open its TCP port as well.
# Select HTTP/2 in the client without CR, HTTP/3 framing, or ECH.
# For IPv6, uncomment the setting and change its value to [::]:10443.
# VPN_HTTP2_BIND_ADDR=0.0.0.0:10443

VPN_NETWORK=10.8.0.0/24
VPN_TUN_DEVICE=mavi0
VPN_DNS=1.1.1.1
# Inner TUN MTU: 1280-1360. Outer QUIC payload MTU is derived automatically.
VPN_MTU=1280
VPN_MSS_CLAMPING=true
VPN_ALLOW_CLIENT_TO_CLIENT=false

# IPv6 tunnel: true = disabled (IPv4-only), false = enabled (IPv4 + IPv6).
# Before setting false, configure on the HOST:
#   net.ipv6.conf.<WAN-interface>.accept_ra=2 (before enabling forwarding)
#   net.ipv6.conf.all.forwarding=1
# Persist the settings using the commands in README.md -> Enabling IPv6.
VPN_DISABLE_IPV6=true
# Internal client subnet used with NAT66. Keep this value for a standard setup;
# do not replace it with your VPS's public IPv6 address or provider prefix.
VPN_NETWORK_V6=fd00::/64
# Seconds to wait for a WAN IPv6 address at startup. If none appears, the
# server continues IPv4-only. Increase to 60 if address assignment is slow.
VPN_IPV6_WAIT=30
# IPv6 DNS sent to clients when the IPv6 tunnel is active.
VPN_DNS_V6=2606:4700:4700::1111

# QUIC censorship resistance; enable the matching client setting.
VPN_CENSORSHIP_RESISTANT=false
# VPN_ECH_PUBLIC_NAME=cloudflare-ech.com

# Optional EXISTING Keycloak server; this stack does not start Keycloak/Postgres.
VPN_KEYCLOAK_ENABLED=false
# VPN_KEYCLOAK_URL=https://auth.example.com
# VPN_KEYCLOAK_REALM=mavi-vpn
# VPN_KEYCLOAK_CLIENT_ID=mavi-client
# VPN_KEYCLOAK_REQUIRED_ROLE=vpn-user
# VPN_KEYCLOAK_REQUIRED_SCOPE=vpn:connect
